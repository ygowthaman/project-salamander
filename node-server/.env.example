# Anthropic API key — read automatically by @anthropic-ai/sdk
ANTHROPIC_API_KEY=sk-ant-...

# Plain postgres URL. NOTE: no `+asyncpg` suffix — that was SQLAlchemy-specific.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/shopping

# CORS origin for the Vite dev server (comma-separated for multiple)
ALLOWED_ORIGINS=http://localhost:5173

# Local dev listens on 8000; the container overrides this with 8080
PORT=8000
