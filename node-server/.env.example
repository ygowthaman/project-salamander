# Anthropic API key — read automatically by @anthropic-ai/sdk.
# Nothing reads it right now: the interpretation layer has not been written yet.
ANTHROPIC_API_KEY=sk-ant-...

# Plain postgres URL, with no dialect suffix.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/salaman_db

# CORS origin for the Vite dev server (comma-separated for multiple)
ALLOWED_ORIGINS=http://localhost:5173

# Local dev listens on 8000; the container overrides this with 8080
PORT=8000

# --- Auth -------------------------------------------------------------------

# Signs access-token JWTs and the OAuth state cookie. Minimum 32 characters.
# Required in production; outside production an insecure dev fallback is used.
# Generate one with: openssl rand -base64 32
JWT_SECRET=change-me-to-at-least-32-random-characters

# Public origin of THIS server. Google redirects back to
# `${PUBLIC_API_URL}/auth/google/callback`, which must exactly match an
# Authorised redirect URI on the OAuth client.
PUBLIC_API_URL=http://localhost:8000

# Where the browser is sent after a successful OAuth round-trip.
FRONTEND_URL=http://localhost:5173

# Cookie Domain attribute. Leave EMPTY locally (both sides are localhost).
# In production set it to the shared registrable domain — `axoliz.ai` — so one
# cookie covers salamander.axoliz.ai and api.axoliz.ai and stays same-site
# under SameSite=Lax.
COOKIE_DOMAIN=

# Google OAuth client (console.cloud.google.com → APIs & Services → Credentials
# → OAuth client ID → Web application). Optional: leave both blank and the
# server still runs with email+password only, with /auth/google returning 503.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
